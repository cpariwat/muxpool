<div class="dashboard">
  <div class="dashboard-header">
    <div class="header-breadcrumb">
      <%= link_to "Projects", projects_path, class: "breadcrumb-link" %>
      <span class="breadcrumb-sep">/</span>
      <h1>Register Project</h1>
    </div>
  </div>

  <div class="form-container">
    <% if flash.now[:alert] %>
      <div class="flash flash-alert"><%= flash.now[:alert] %></div>
    <% end %>

    <%= form_with url: projects_path, method: :post, class: "project-form" do |f| %>
      <div class="form-group">
        <label for="name">Project Name</label>
        <input type="text" name="name" id="name" placeholder="my-project" class="form-input" autofocus value="<%= params[:name] %>">
      </div>
      <div class="form-group">
        <label for="path">Repository Path</label>
        <input type="text" name="path" id="path" placeholder="/home/user/projects/my-project" class="form-input" value="<%= params[:path] %>">
        <p class="form-hint">Absolute path to a git repository on this machine.</p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Register</button>
        <%= link_to "Cancel", projects_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
