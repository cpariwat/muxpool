<div class="terminal-page"
     data-controller="terminal"
     data-terminal-session-value="<%= @session_name %>">
  <div class="terminal-header">
    <%= link_to "← Sessions", sessions_path, class: "btn btn-ghost btn-sm" %>
    <div class="session-title-group" data-controller="inline-edit">
      <div class="session-switcher" data-controller="dropdown" data-inline-edit-target="display">
        <button class="session-switcher-btn" data-action="click->dropdown#toggle">
          <span class="terminal-title"><%= @session_name %></span>
          <svg class="switcher-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="session-switcher-menu" data-dropdown-target="menu" hidden>
          <% @sessions.each do |s| %>
            <%= link_to session_path(s.name), class: "switcher-item #{'switcher-item-active' if s.name == @session_name}", data: { turbo: false } do %>
              <span class="status-dot <%= s.attached ? 'attached' : 'detached' %>"></span>
              <span class="switcher-item-name"><%= s.name %></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <button class="btn-rename" data-action="click->inline-edit#edit" title="Rename session">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
      <%= form_with url: session_path(@session_name), method: :patch, class: "rename-form", data: { inline_edit_target: "form", turbo: false } do |f| %>
        <input type="text" name="name" value="<%= @session_name %>" class="rename-input" data-inline-edit-target="input" data-action="keydown->inline-edit#keydown">
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
        <button type="button" class="btn btn-ghost btn-sm" data-action="click->inline-edit#cancel">Cancel</button>
      <% end %>
    </div>
    <div class="terminal-header-actions">
      <div class="scroll-controls">
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#scrollMode">Scroll</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#scrollUp">&#9650;</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#scrollDown">&#9660;</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#exitScroll">Exit</button>
      </div>
      <div class="pane-controls">
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#splitHorizontal" title="Split Horizontal (Ctrl-B &quot;)">Split H</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#splitVertical" title="Split Vertical (Ctrl-B %)">Split V</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#nextPane" title="Next Pane (Ctrl-B o)">Next</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#zoomPane" title="Zoom Pane (Ctrl-B z)">Zoom</button>
        <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#closePane" title="Close Pane (Ctrl-B x)">Close</button>
      </div>
      <button class="btn btn-ghost btn-sm" data-action="mousedown->terminal#preventFocus click->terminal#paste">Paste</button>
      <%= button_to open_ide_session_path(@session_name), method: :post, class: "btn btn-ghost btn-sm" do %>
        Open in <%= TmuxSession.ide_name %>
      <% end %>
      <button class="btn btn-ghost btn-sm" data-action="click->terminal#reconnect" data-terminal-target="reconnectBtn">
        Reconnect
      </button>
      <%= button_to session_path(@session_name), method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: "Kill session '#{@session_name}'?" } do %>
        Delete
      <% end %>
    </div>
  </div>
  <div class="attach-command" data-controller="clipboard" data-clipboard-text-value="tmux -S <%= TmuxSession.socket_path %> attach -t <%= @session_name %>">
    <code>tmux -S <%= TmuxSession.socket_path %> attach -t <%= @session_name %></code>
    <button class="btn-copy" data-action="click->clipboard#copy" data-clipboard-target="button" title="Copy to clipboard">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    </button>
  </div>
  <div class="terminal-container">
    <div data-terminal-target="terminal" class="terminal-element"></div>
  </div>
</div>
